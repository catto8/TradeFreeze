-- CONTROLS
local states = {
    ["Freeze Trade"] = false,
    ["Clear Items"] = false,
    ["Anti Bypass"] = false
}

local function createToggle(name, icon, y)

    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -20, 0, 43)
    row.Position = UDim2.fromOffset(10, y)
    row.BackgroundColor3 = Color3.fromRGB(40, 29, 57)
    row.BorderSizePixel = 0
    row.Parent = main
    corner(row, 9)
    stroke(row, Color3.fromRGB(85, 57, 115), 1)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -90, 1, 0)
    label.Position = UDim2.fromOffset(10, 0)
    label.BackgroundTransparency = 1
    label.Text = icon .. "  " .. name
    label.TextColor3 = Color3.fromRGB(245, 235, 255)
    label.TextSize = 12
    label.Font = Enum.Font.GothamBold
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = row

    local button = Instance.new("TextButton")
    button.Size = UDim2.fromOffset(57, 27)
    button.Position = UDim2.new(1, -65, 0.5, -13)
    button.BorderSizePixel = 0
    button.Font = Enum.Font.GothamBlack
    button.TextSize = 10
    button.Parent = row
    corner(button, 7)

    local function update()
        local enabled = states[name]

        button.Text = enabled and "ON" or "OFF"
        button.BackgroundColor3 = enabled
            and Color3.fromRGB(44, 190, 103)
            or Color3.fromRGB(110, 53, 72)
        button.TextColor3 = Color3.new(1, 1, 1)
    end

    button.MouseButton1Click:Connect(function()
        states[name] = not states[name]
        update()
    end)

    update()
end

createToggle("Freeze Trade", "❄️", 75)
